# ==== Pancake credentials (ชุดเดียวกับที่ใช้ในเวอร์ชัน GAS) ====
# POS API Key: Pancake POS → ตั้งค่า → ขั้นสูง → เชื่อมต่อภายนอก → API Key
POS_API_KEY=
# POS Shop ID: ตัวเลขร้านใน URL ของ POS
POS_SHOP_ID=
# Access Token: pages.fm → บัญชี → ตั้งค่าส่วนตัว → API Access Token
PANCAKE_ACCESS_TOKEN=

# ==== Supabase (Project Settings → API) ====
# URL ของโปรเจกต์ เช่น https://xxxx.supabase.co
SUPABASE_URL=
# service_role key (ความลับ! ใช้เฉพาะ worker — ห้ามใส่ฝั่ง frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ==== ล็อกอินรายคน (app_users) ====
# ความลับสำหรับเซ็น cookie session • สุ่มยาว ๆ เช่น `openssl rand -base64 32`
# ต้องตั้งบน Vercel ด้วย (Production + Preview) • ถ้าไม่ตั้งจะ fallback ไปใช้ DASHBOARD_PASSWORD
# ⚠️ เปลี่ยนค่านี้ = เตะทุกคนออกจากระบบ (cookie ใบเดิมตรวจไม่ผ่าน)
AUTH_SECRET=

# ==== รหัสผ่านรวมทีมเดิม (legacy) ====
# ระบบล็อกอินตอนนี้ใช้บัญชีรายคนในตาราง app_users แล้ว — ตัวนี้เหลือไว้เป็น fallback ของ AUTH_SECRET
DASHBOARD_PASSWORD=

# ==== Meta Marketing API (ค่าแอดจริง + ครีเอทีฟ) ====
# System User token จาก Meta Business → ใช้ทับ ad_daily.spend และดึงรูป/คลิปของแอด
# ถ้าไม่ตั้ง job ค่าแอด/ครีเอทีฟจะข้ามไปเงียบ ๆ (ส่วนอื่นของเว็บยังทำงานปกติ)
META_ACCESS_TOKEN=

# ==== คีย์สำหรับ endpoint สาธารณะ /api/public/umap (ไม่ตั้ง = ปิดการเข้าถึง) ====
UMAP_PUBLIC_KEY=
